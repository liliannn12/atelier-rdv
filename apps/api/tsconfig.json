{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "verbatimModuleSyntax": true,
      "skipLibCheck": true,
      "types": ["node"],
      "outDir": "dist",
      "rootDir": "src"
    },
    "include": ["src"]
  }